NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enable only after the Supabase Google provider and callback have been tested.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Optional face check (employer sends a link, new hire sends back a score).
# Random string, 24+ characters. Signs the private links. Required in production.
SCAN_LINK_SECRET=
# Private Vercel Blob store that holds session status. Memory is used when unset (local dev only).
BLOB_READ_WRITE_TOKEN=
# Resend (https://resend.com) sends the agreement email. Without it, employers copy the link instead.
RESEND_API_KEY=
# Verified sender, e.g. "EasyVerify <hello@yourdomain.com>". The default onboarding@resend.dev only delivers to your own Resend account email.
RESEND_FROM=
