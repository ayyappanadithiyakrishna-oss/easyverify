{
  "name": "easyverify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --test tests/dates.test.mjs && tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib proxy.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:worker": "esbuild workers/llama.js --bundle --format=esm --platform=browser --outfile=public/llama-worker.js",
    "prebuild": "npm run build:worker",
    "predev": "npm run build:worker"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@vladmandic/human": "3.3.6",
    "lucide-react": "0.577.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "supabase": "2.120.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
